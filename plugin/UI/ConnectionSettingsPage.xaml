<Page x:Class="revit_mcp_plugin.UI.ConnectionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:revit_mcp_plugin.UI"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Connection Settings" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Configure how the plugin connects to the MCP server"
                       Foreground="#666666" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Settings Form -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <!-- Connection Mode -->
            <TextBlock Text="Connection Mode" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton x:Name="TcpRadio" Content="TCP (Local Server)"
                             GroupName="Mode" IsChecked="True" Margin="0,0,30,0"
                             Checked="Mode_Changed"/>
                <RadioButton x:Name="WsRadio" Content="WebSocket (Cloud)"
                             GroupName="Mode"
                             Checked="Mode_Changed"/>
            </StackPanel>

            <!-- TCP Settings -->
            <Border x:Name="TcpPanel" Padding="15" Background="#f9f9f9"
                    BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="TCP Settings" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Port:" VerticalAlignment="Center"/>
                        <TextBox x:Name="PortTextBox" Grid.Column="1" Text="18080"
                                 Width="100" HorizontalAlignment="Left" Padding="5,3"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- WebSocket Settings -->
            <Border x:Name="WsPanel" Padding="15" Background="#f9f9f9"
                    BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4"
                    Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Pair with a bridge server" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="On the site click 'Pair a Revit', then enter the site address and the code here. The server answers with this device's id, token and WebSocket URL."/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Server:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ServerTextBox" Grid.Column="1" Text="" Padding="5,3"
                                 ToolTip="Site address, e.g. https://bridge.example.com (not the wss:// URL)"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pairing code:" VerticalAlignment="Center"/>
                        <TextBox x:Name="PairCodeTextBox" Grid.Column="1" Text="" Padding="5,3"
                                 Width="120" HorizontalAlignment="Left" CharacterCasing="Upper"
                                 ToolTip="XXXX-XXXX, valid for 10 minutes, single use"/>
                        <Button x:Name="PairButton" Grid.Column="2" Content="Pair" Width="70" Height="26"
                                Click="PairButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="PairStatusText" Text="" Foreground="#666" TextWrapping="Wrap"
                               Margin="100,0,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Device:" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DeviceText" Grid.Column="1" Text="Not paired"
                                   VerticalAlignment="Center" Foreground="#666"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="WebSocket URL:" VerticalAlignment="Center"/>
                        <TextBox x:Name="WsUrlTextBox" Grid.Column="1" Text="" Padding="5,3"
                                 IsReadOnly="True" Background="#f0f0f0"
                                 ToolTip="Returned by the server when pairing; stored in Commands\commandRegistry.json as wsUrl"/>
                    </Grid>
                    <CheckBox x:Name="ConfirmEachRunCheckBox" IsChecked="True"
                              Content="Ask before each ad-hoc code run (recommended)"
                              ToolTip="Shows a Yes/No dialog in Revit before send_code_to_revit requests that the server marks for confirmation. Capability packs never ask."/>
                </StackPanel>
            </Border>

            <!-- Status -->
            <Border Padding="10" Background="#f0f8ff" BorderBrush="#b0d4f1"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Current Status" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatusText" Text="Not connected" Foreground="#666"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Width="80" Height="30" Background="#0078D7" Foreground="White"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
